# Local demo: synthetic data and simulated payments only.
DEMO_MODE=true
# Required for pnpm dev/start and hosting; pnpm demo generates a local secret.
SESSION_SECRET=
# Live database (never used in DEMO_MODE).
DATABASE_URL=
ENROLLMENT_API_KEY=

# Optional dedicated Neon DEMO database. Never point this at real customer data.
DEMO_DATABASE_URL=
